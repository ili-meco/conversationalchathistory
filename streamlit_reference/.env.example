FABRIC_COSMOS_ENDPOINT=https://<fabric-cosmos-endpoint>
FABRIC_COSMOS_DATABASE=GovernanceChatAnalytics
FABRIC_COSMOS_CONTAINER=conversations

# Existing Microsoft Foundry project and model deployment.
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL=<model-deployment-name>
AZURE_TENANT_ID=<azure-tenant-id>
# AZURE_SUBSCRIPTION_ID=<azure-subscription-id>
# FOUNDRY_AGENT_INSTRUCTIONS=<optional custom system instructions>

# Local development with Azure CLI in the Fabric tenant.
FABRIC_TENANT_ID=<fabric-tenant-id>

# Set all three only for cross-tenant App Service authentication.
# FABRIC_TENANT_ID=<fabric-tenant-id>
# FABRIC_CLIENT_ID=<multi-tenant-app-registration-client-id>
# FABRIC_MANAGED_IDENTITY_CLIENT_ID=<user-assigned-managed-identity-client-id>

# Local development only. Never enable this in production.
CHAT_HISTORY_ALLOW_DEMO_USER=false
CHAT_HISTORY_DEMO_USER_ID=local-developer