flowchart LR
    User["Signed-in user"]

    subgraph Browser["User browser"]
        WebUI["Existing Flask-rendered UI<br/>templates/index.html"]
        ActiveId["Browser state<br/>activeConversationId only"]
    end

    subgraph AppService["Azure App Service Web App"]
        EasyAuth["App Service Authentication<br/>Microsoft Entra ID"]
        Routes["Flask routes<br/>app.py and flask_routes.py"]
        Identity["Request identity<br/>X-MS-CLIENT-PRINCIPAL-ID"]
        Repository["Durable history service<br/>repository.py and cosmos_repository.py"]
        RAG["RAG request orchestration<br/>Search, prompt, and response"]
        ManagedIdentity["App Service managed identity"]
    end

    subgraph Network["Approved outbound connectivity"]
        Integration["App Service outbound path<br/>VNet Integration when required"]
        CosmosEndpoint["FABRIC_COSMOS_ENDPOINT<br/>TLS and tenant network policy"]
        SearchEndpoint["Azure AI Search endpoint<br/>Public or private access"]
        OpenAIEndpoint["Azure OpenAI endpoint<br/>Public or private access"]
    end

    subgraph Data["Fabric Cosmos DB"]
        Container["conversations container<br/>Partition key: /userId"]
        Conversation["Conversation item<br/>id = conversationId"]
        Messages["Message items<br/>id = messageId"]
        Feedback["Feedback items<br/>id = feedback-messageId"]
    end

    Search["Azure AI Search<br/>Knowledge index"]
    OpenAI["Azure OpenAI<br/>Chat model"]

    User --> WebUI
    WebUI <--> ActiveId
    WebUI -->|"HTTPS request with Entra session"| EasyAuth
    EasyAuth --> Routes
    EasyAuth -->|"Adds authenticated principal header"| Identity
    Identity --> Routes

    Routes -->|"Create, list, reopen, send, rate, delete"| Repository
    Repository -->|"Trusted server-side transcript"| RAG
    Routes --> RAG
    RAG -->|"Search query and model prompt"| Integration
    Repository -->|"Point reads and partition-scoped queries"| Integration

    Integration --> CosmosEndpoint
    Integration --> SearchEndpoint
    Integration --> OpenAIEndpoint
    CosmosEndpoint --> Container
    SearchEndpoint --> Search
    OpenAIEndpoint --> OpenAI

    ManagedIdentity -. "Token and data-plane RBAC" .-> Container
    ManagedIdentity -. "Search Index Data Reader" .-> Search
    ManagedIdentity -. "Cognitive Services OpenAI User" .-> OpenAI

    Container --> Conversation
    Container --> Messages
    Container --> Feedback
    Conversation -. "conversationId" .-> Messages
    Messages -. "messageId" .-> Feedback

    Routes -->|"JSON response with IDs and assistant message"| WebUI